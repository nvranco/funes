<mxfile host="app.diagrams.net"><diagram name="1 · Pipeline" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="2750" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Funes · pipeline de recomendación&lt;/b&gt;&lt;br&gt;Solo literatura (MACRO_UNICA). Lectura de arriba hacia abajo. Azul = llamada LLM (con su meta-prompt en la página 2) · verde = embedding · rojo = filtro duro · naranja = código determinista · violeta = almacén · línea punteada roja = bucle." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c3" value="LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1560" y="14" width="190" height="28" as="geometry"/></mxCell><mxCell id="c4" value="Embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1560" y="46" width="190" height="28" as="geometry"/></mxCell><mxCell id="L1" value="① Entrada del lector" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1760" height="380" as="geometry"/></mxCell><mxCell id="c5" value="Saludo → «Comenzar»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="240" width="150" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;q2 · desafío y longitud&lt;/b&gt;&lt;br&gt;«¿Qué nivel de desafío y longitud sentís que buscás en este momento?»&lt;br&gt;&lt;i&gt;corto · intermedio · largo&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="215" width="250" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;q4a&lt;/b&gt;&lt;br&gt;«¿Tenés algún libro o autor que se parezca a lo que buscás hoy?»" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="270" height="160" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Camino A&lt;/b&gt; · nombró una lectura&lt;br&gt;Escribe libro + autor.&lt;br&gt;No se pregunta nada más: el ancla arma el perfil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="140" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;q4c&lt;/b&gt;&lt;br&gt;«¿Cómo preferís que te ayude?»" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="265" width="270" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Camino B&lt;/b&gt; · «Te digo lo que quiero»&lt;br&gt;q4b texto libre: «¿Qué te gustaría encontrar en tu próxima lectura?»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="250" width="330" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Camino C&lt;/b&gt; · «Haceme preguntas»&lt;br&gt;q1 estado de ánimo → q1b forma → q3 valor central → q4b «¿Qué te gustaría encontrar…?»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="360" width="330" height="90" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Sí + nombre" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="No se me ocurre ninguno" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="decir" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="preguntas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L2" value="② LLM ① · Expansión del ancla" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1760" height="350" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Entrada al LLM&lt;/b&gt;&lt;br&gt;OBRA_O_AUTOR: q4a&lt;br&gt;LO_QUE_VALORA: q4b&lt;br&gt;&lt;i&gt;(dos campos etiquetados)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="590" width="250" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;LLM ① · bibliotecario&lt;/b&gt;&lt;br&gt;gemini-2.5-flash&lt;br&gt;temperature 0&lt;br&gt;meta-prompt: _SYSTEM_ANCLA&lt;br&gt;traduce la referencia a ficha de catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="290" height="140" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;¿Reconoció la obra?&lt;/b&gt;&lt;br&gt;conocido = true&lt;br&gt;o no hay obra nombrada" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="560" width="250" height="160" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Reintento con búsqueda web&lt;/b&gt;&lt;br&gt;gpt-5-mini:online&lt;br&gt;mismo meta-prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="740" width="250" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Salida JSON&lt;/b&gt;&lt;br&gt;{conocido,&lt;br&gt;&amp;nbsp;descripcion: 40-60 palabras, ficha de catálogo,&lt;br&gt;&amp;nbsp;experiencia: 40-60 palabras, cómo se lee}&lt;br&gt;limpia citas web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="570" width="330" height="140" as="geometry"/></mxCell><mxCell id="c23" value="Caché en memoria por texto crudo (1 h, 500 entradas).&lt;br&gt;Si el LLM falla se embebe el texto crudo del lector: nunca es requisito." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="570" width="250" height="140" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c8" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c10" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c11" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L3" value="③ Vectorización · text-embedding-3-small" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1760" height="250" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;V perfil&lt;/b&gt;&lt;br&gt;consultas de q2 (+ q1, q3 en camino C), reescritas en idioma de catálogo&lt;br&gt;&lt;i&gt;sin LLM: sale de lo contestado en ①&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="940" width="300" height="130" as="geometry"/></mxCell><mxCell id="c33" value="Caché de vectores: 1 h, 300 entradas, por texto.&lt;br&gt;Centrado de vectores apagado (_CENTRAR = False).&lt;br&gt;V ajuste y V corrección se generan más tarde, en ⑥ y ⑦, y entran al mismo ranking." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="940" width="480" height="130" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;V ancla&lt;/b&gt;&lt;br&gt;embebe la &lt;i&gt;descripcion&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1010" y="940" width="270" height="130" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;V ancla-experiencia&lt;/b&gt;&lt;br&gt;embebe la &lt;i&gt;experiencia&lt;/i&gt;&lt;br&gt;solo caminos A y B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1330" y="940" width="270" height="130" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c22" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c22" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L4" value="④ Recorte del catálogo · filtros duros (metadata, antes de calcular un coseno)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1760" height="320" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Catálogo&lt;/b&gt;&lt;br&gt;3.576 libros · literatura 2.167&lt;br&gt;por libro: embedding_abstracto,&lt;br&gt;embedding_experiencia" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1230" width="250" height="150" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;F1 · macro&lt;/b&gt;&lt;br&gt;solo literatura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="1240" width="245" height="120" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;F2 · libro nombrado&lt;/b&gt;&lt;br&gt;se excluye por título, nunca por autor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="1240" width="245" height="120" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;F3 · forma (q1b)&lt;/b&gt;&lt;br&gt;solo camino C: novela · género · clásicos · breves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="940" y="1240" width="245" height="120" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;F4 · ya leídos&lt;/b&gt;&lt;br&gt;por título + autor (otra edición también)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1210" y="1240" width="245" height="120" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;F5 · páginas (q2)&lt;/b&gt;&lt;br&gt;corto ≤260 · intermedio 180-420 · largo ≥300" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1480" y="1240" width="245" height="120" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Piso del pool = 80 libros.&lt;/b&gt; Si un filtro deja menos, se afloja de abajo hacia arriba: primero páginas, después forma. La macro nunca se afloja. Un libro sin nro_paginas o sin rasgos nunca se excluye por ese dato." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1385" width="1300" height="70" as="geometry"/></mxCell><mxCell id="L5" value="⑤ Ranking · scoring híbrido por vectores" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="1760" height="360" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Puntaje de cada libro del pool&lt;/b&gt;&lt;br&gt;&lt;br&gt;w perfil · cos(V perfil, experiencia)&lt;br&gt;+ w ancla · cos(V ancla, abstracto)&lt;br&gt;+ w ancla-exp · cos(V ancla-exp, experiencia) &lt;i&gt;(A y B)&lt;/i&gt;&lt;br&gt;+ w ajuste · cos(V ajuste, experiencia)&lt;br&gt;+ w corrección · cos(V corrección, abstracto)&lt;br&gt;&lt;br&gt;Detalle de pesos en la página 3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="1580" width="560" height="220" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Top-8 candidatos&lt;/b&gt;&lt;br&gt;(con corrección: pool entero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="1580" width="260" height="90" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Penalización por repetición&lt;/b&gt;&lt;br&gt;−0,25 × similitud con lo ya mostrado&lt;br&gt;(mismo autor = 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="740" y="1705" width="260" height="100" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Libro elegido&lt;/b&gt;&lt;br&gt;el de mayor puntaje final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="1630" width="260" height="100" as="geometry"/></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c43" target="c50"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="Recibe los vectores de ③ y el pool recortado de ④." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="1810" width="330" height="50" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c51" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Por qué cuatro vectores y no un texto concatenado&lt;/b&gt;&lt;br&gt;Lo corto desaparece al concatenar: el ancla eran 9 palabras sobre 56 y era inerte. Cada señal tiene su vector y su peso." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="1580" width="330" height="220" as="geometry"/></mxCell><mxCell id="L6" value="⑥ Presentación · LLM ② voz + guardas" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="1900" width="1760" height="360" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;«¿Leíste X, de Y?»&lt;/b&gt;&lt;br&gt;pregunta antes de recomendar" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1970" width="240" height="150" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;LLM ③ · opinión → búsqueda&lt;/b&gt;&lt;br&gt;gemini-2.5-flash · T 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="2140" width="240" height="100" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;LLM ② · librero Funes&lt;/b&gt;&lt;br&gt;gemini-2.5-flash · response_format json_object&lt;br&gt;meta-prompt: _SYSTEM_VOZ + _REGLAS_DE_VOZ&lt;br&gt;entrada: lo que el lector eligió, la referencia, título, autor y sinopsis interna" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="1970" width="320" height="170" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Guardas de salida&lt;/b&gt;&lt;br&gt;JSON válido y no vacío&lt;br&gt;sin «:» en lo que lee la persona&lt;br&gt;hasta 2 intentos; si falla, error y botón Reintentar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="1970" width="300" height="170" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;Mensajes al lector&lt;/b&gt;&lt;br&gt;1. «Entonces, te recomiendo TÍTULO, de AUTOR.»&lt;br&gt;2. de qué va&lt;br&gt;3. por qué es para vos&lt;br&gt;(el «empujón» se guarda aparte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="1970" width="330" height="170" as="geometry"/></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c53" target="c60"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c66" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c60" target="c62"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c60" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;V ajuste&lt;/b&gt;&lt;br&gt;embebe el texto afirmativo → entra al ranking ⑤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="2155" width="330" height="90" as="geometry"/></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c61" target="c68"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;dashed=1;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c68" target="c51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="2200"/><mxPoint x="1780" y="1555"/><mxPoint x="870" y="1555"/></Array></mxGeometry></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L7" value="⑦ Veredicto y bucle de corrección" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;startSize=44;fontSize=15;fontStyle=1;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="2290" width="1760" height="400" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;«¿Qué te parece esta recomendación?»&lt;/b&gt;&lt;br&gt;Precisa · Dudosa · Floja" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="2370" width="280" height="160" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;Precisa&lt;/b&gt;&lt;br&gt;muestra el empujón&lt;br&gt;«¿Dónde lo consigo?» (búsqueda de Google)&lt;br&gt;«Contame más» → LLM ⑤ (_SYSTEM_INFO_EXTRA)&lt;br&gt;«Recomendame otro libro»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="2350" width="360" height="130" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Dudosa o Floja&lt;/b&gt;&lt;br&gt;«¿Qué estabas esperando en mi recomendación?»&lt;br&gt;respuesta obligatoria, texto libre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="2520" width="360" height="120" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;LLM ④ · reformulador&lt;/b&gt;&lt;br&gt;gemini-2.5-flash · T 0&lt;br&gt;meta-prompt: _SYSTEM_REFORMULAR&lt;br&gt;convierte el motivo en un pedido afirmativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="2510" width="320" height="140" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;Topes&lt;/b&gt;&lt;br&gt;3 recomendaciones por vuelta, 2 vueltas (6 en total).&lt;br&gt;«Arranquemos de nuevo» vuelve a q2 y conserva lo ya mostrado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1290" y="2350" width="430" height="150" as="geometry"/></mxCell><mxCell id="c78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c64" target="c73"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c79" value="Precisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c73" target="c74"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c80" value="Dudosa / Floja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c73" target="c75"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c75" target="c76"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;V corrección&lt;/b&gt;&lt;br&gt;embebe el pedido afirmativo → ranking ⑤ sobre el pool entero (no solo los 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="2525" width="330" height="110" as="geometry"/></mxCell><mxCell id="c83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="c76" target="c82"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c84" value="re-ranking sobre el pool entero" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;dashed=1;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c82" target="c51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="2580"/><mxPoint x="1780" y="1555"/><mxPoint x="870" y="1555"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 · Meta-prompts" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Meta-prompts · anatomía de cada llamada LLM&lt;/b&gt;&lt;br&gt;Estructura estándar de un prompt (rol · contexto/entrada · tarea · restricciones · formato de salida · parámetros). Los textos son resúmenes fieles de las constantes de app/funes_chat/nucleo.py; el código es la fuente del texto literal. Todas las llamadas van por OpenRouter. La salida de cada una alimenta a la siguiente: es una cadena de prompts (prompt chaining), con una compuerta (routing) en el ancla y guardas de validación a la salida de la voz." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;font-size:14px;color:#1F4E8C&quot;&gt;&lt;b&gt;LLM ① · Expansión del ancla — _SYSTEM_ANCLA&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ROL&lt;/b&gt; bibliotecario que traduce lo que dice un lector a la ficha de catálogo del libro que habría que darle.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ENTRADA&lt;/b&gt; dos campos etiquetados, no concatenados: &lt;i&gt;OBRA_O_AUTOR&lt;/i&gt; (lo que nombró, puede venir mal escrito) y &lt;i&gt;LO_QUE_VALORA&lt;/i&gt; (qué quiere volver a encontrar: ES EL PEDIDO).&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;TAREA&lt;/b&gt; clasificar la entrada en una de tres clases y actuar distinto: (a) autor u obra → describir esa obra o su clase; (b) rasgo de una obra → describir libros QUE TENGAN ESE RASGO, no la obra; (c) descripción sin nombres → reescribir en idioma de catálogo.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;RESTRICCIONES&lt;/b&gt; tercera persona, sin opinar, sin dirigirse al lector ni mencionar que hay una referencia, sin inventar datos. &lt;i&gt;experiencia&lt;/i&gt;: elegir 2-3 rasgos y omitir el resto; arrancar con adjetivo o sustantivo de ritmo/tono.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;SALIDA&lt;/b&gt; JSON {conocido: bool, descripcion: 40-60 palabras (de qué trata), experiencia: 40-60 palabras (cómo se lee)}.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;PARÁMETROS&lt;/b&gt; gemini-2.5-flash · temperature 0 · reintento con gpt-5-mini:online solo si conocido = false y hubo obra nombrada.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;POR QUÉ ASÍ&lt;/b&gt; preguntar nombre y rasgo por separado convierte la desambiguación en estructura en vez de una instrucción que el modelo tenía que adivinar: «el sistema de casas de Harry Potter» pide mundos divididos en grupos, no novelas de magos.&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="560" height="470" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;font-size:14px;color:#1F4E8C&quot;&gt;&lt;b&gt;LLM ② · Voz de la recomendación — _SYSTEM_VOZ + _REGLAS_DE_VOZ&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ROL&lt;/b&gt; Funes, un librero que acaba de elegir un libro para alguien con quien estuvo charlando. Nunca dice que usó filtros, opciones, base de datos, algoritmo o formulario.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ENTRADA&lt;/b&gt; lo que la persona eligió con las palabras que leyó en pantalla · la referencia y lo que quería repetir · título y autor del libro · sinopsis interna (contexto, no se cita textual).&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;TAREA&lt;/b&gt; cuatro mensajes, cada uno un campo del JSON: &lt;i&gt;libro&lt;/i&gt; («Entonces, te recomiendo TÍTULO, de AUTOR.»), &lt;i&gt;de_que_va&lt;/i&gt; (1-2 oraciones, sin explicar aún por qué), &lt;i&gt;por_que_es_para_vos&lt;/i&gt; (2-3 oraciones, conecta con lo que dijo), &lt;i&gt;empujon&lt;/i&gt; («Este libro PARTICULARIDAD, y también VUELTA DE TUERCA»; solo lo lee quien ya dijo que le sirve).&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;RESTRICCIONES&lt;/b&gt; si el libro NO cumple algo que pidió, decirlo derecho, no maquillarlo · no inventar trama, final ni personajes que no estén en la sinopsis · sin exclamaciones ni adjetivos de contratapa · no cerrar saludando.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;VOZ (compartida)&lt;/b&gt; habla de librero en el mostrador, no de académico · prohibido «:» en lo que lee la persona · prohibido anunciar «justamente eso», «como pediste»: que el lector cierre solo.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;SALIDA&lt;/b&gt; JSON {libro, de_que_va, por_que_es_para_vos, empujon}, un string por campo, español rioplatense, sin markdown.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;PARÁMETROS&lt;/b&gt; gemini-2.5-flash · response_format json_object · hasta 2 intentos.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;DECISIÓN&lt;/b&gt; el campo &lt;i&gt;experiencia&lt;/i&gt; del libro NO se pasa: habla de lo que exige leerlo y empuja al modelo a decir justo lo que está prohibido.&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="560" height="470" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-size:14px;color:#1F4E8C&quot;&gt;&lt;b&gt;Guardas, caché y fallos&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;JSON&lt;/b&gt; &lt;i&gt;_parsear_json_llm&lt;/i&gt; acepta bloques ```json; un JSON roto cuenta como intento fallido.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;MARCADOR&lt;/b&gt; &lt;i&gt;_fuga_de_marcador&lt;/i&gt; rechaza cualquier «:» en lo que va a leer la persona. Segunda red además del campo &lt;i&gt;empujon&lt;/i&gt; separado (antes un marcador de texto «EMPUJON:» se filtraba mal escrito a la pantalla).&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ANCLA&lt;/b&gt; si ningún modelo devuelve una descripción usable se devuelve vacío y se embebe el texto crudo del lector.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;CACHÉ&lt;/b&gt; anclas por texto crudo (1 h) · vectores por texto (1 h) · opiniones sobre leídos por (libro, opinión).&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;PRINCIPIO&lt;/b&gt; toda llamada auxiliar es una mejora, nunca un requisito: si falla, la conversación sigue sin esa señal.&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="500" height="470" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:14px;color:#1F4E8C&quot;&gt;&lt;b&gt;LLM ③ · Opinión sobre un libro leído — _SYSTEM_LEIDO&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ROL&lt;/b&gt; traductor de «ya lo leí y me pareció X» a una descripción afirmativa de qué buscar ahora.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ENTRADA&lt;/b&gt; «Libro: TÍTULO, de AUTOR. Lo que dijo el lector: OPINIÓN».&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;TAREA&lt;/b&gt; si le gustó, describir los rasgos que conviene repetir sin nombrar libro ni autor; si no, describir lo contrario.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;RESTRICCIONES&lt;/b&gt; siempre en positivo: los embeddings no entienden negaciones («nada denso» empuja hacia lo denso). Prohibido «no», «nada de», «menos», «sin». Una oración corta en idioma de ficha.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;SALIDA / PARÁMETROS&lt;/b&gt; una oración de texto plano · gemini-2.5-flash · temperature 0 · se vectoriza como V ajuste.&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="560" height="330" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;font-size:14px;color:#1F4E8C&quot;&gt;&lt;b&gt;LLM ④ · Reformulador del rechazo — _SYSTEM_REFORMULAR&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ROL&lt;/b&gt; convierte lo que escribió el lector al pedir otra recomendación en un pedido afirmativo.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;TAREA&lt;/b&gt; primero clasificar el texto: si YA es un pedido en positivo («un clásico o algo viejo»), dejarlo igual prolijizado; si es una QUEJA («muy denso y aburrido»), convertirla en el rasgo contrario.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;RESTRICCIONES&lt;/b&gt; no nombrar el libro rechazado · sin negaciones · una oración en rioplatense · en la duda, tratarlo como pedido: repetir lo dicho es un error más barato que invertirlo.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;POR QUÉ ASÍ&lt;/b&gt; un ejemplo único («muy denso y viejo» → «ágil y contemporáneo») enseñó que «viejo» siempre es queja y dio vuelta a quien pedía justo «un clásico». Por eso la clasificación va primero.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;SALIDA / PARÁMETROS&lt;/b&gt; una oración · gemini-2.5-flash · temperature 0 · se vectoriza como V corrección.&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="630" width="560" height="330" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;font-size:14px;color:#1F4E8C&quot;&gt;&lt;b&gt;LLM ⑤ · Contame más — _SYSTEM_INFO_EXTRA&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;ROL&lt;/b&gt; Funes, ya recomendó un libro y el lector pidió saber más.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;TAREA&lt;/b&gt; dos ideas, cada una un mensaje: (1) ampliar la sinopsis en 2-3 oraciones sin spoilear; (2) 1-2 oraciones de por qué este libro le queda bien a ESTE lector.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;RESTRICCIONES&lt;/b&gt; no repetir literalmente sus respuestas · no cortar un mensaje en mitad de una oración o sigla · + _REGLAS_DE_VOZ.&lt;/p&gt;&lt;p style=&quot;margin:4px 0&quot;&gt;&lt;b&gt;SALIDA&lt;/b&gt; un mensaje por línea · es opcional (botón «Contame más», una vez por libro).&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="630" width="500" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Vectores y ranking" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Vectores y ranking&lt;/b&gt;&lt;br&gt;Qué texto se vectoriza, contra qué vector del libro se compara y cuánto pesa. Todos los embeddings son openai/text-embedding-3-small; cada libro tiene su propio vector por campo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1700" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Componente&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Qué texto se vectoriza&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="400" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Se compara contra&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="280" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Peso base y cuándo existe&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="660" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Perfil&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="360" height="90" as="geometry"/></mxCell><mxCell id="c8" value="consultas de q2 (siempre) y de q1 y q3 (camino C), en idioma de catálogo: no las etiquetas de los botones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="180" width="400" height="90" as="geometry"/></mxCell><mxCell id="c9" value="embedding_experiencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="180" width="280" height="90" as="geometry"/></mxCell><mxCell id="c10" value="lo que sobra: nunca menos de 0,25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="660" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Ancla · descripción&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="360" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i&gt;descripcion&lt;/i&gt; del LLM ① (qué es el libro que pide)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="400" height="90" as="geometry"/></mxCell><mxCell id="c13" value="embedding_abstracto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="270" width="280" height="90" as="geometry"/></mxCell><mxCell id="c14" value="0,50 en camino C · 0,75 × 55 % en A y B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="270" width="660" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ancla · experiencia&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="360" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;i&gt;experiencia&lt;/i&gt; del LLM ① (cómo se lee)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="400" height="90" as="geometry"/></mxCell><mxCell id="c17" value="embedding_experiencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="360" width="280" height="90" as="geometry"/></mxCell><mxCell id="c18" value="solo A y B: 0,75 × 45 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="360" width="660" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Ajuste&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="360" height="90" as="geometry"/></mxCell><mxCell id="c20" value="opinión sobre libros leídos, reescrita en positivo por el LLM ③" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="400" height="90" as="geometry"/></mxCell><mxCell id="c21" value="embedding_experiencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="280" height="90" as="geometry"/></mxCell><mxCell id="c22" value="0,25 · solo si dijo «ya lo leí»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="450" width="660" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Corrección&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="360" height="90" as="geometry"/></mxCell><mxCell id="c24" value="motivo del rechazo, reescrito en positivo por el LLM ④" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400" y="540" width="400" height="90" as="geometry"/></mxCell><mxCell id="c25" value="embedding_abstracto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="540" width="280" height="90" as="geometry"/></mxCell><mxCell id="c26" value="0,35 · solo tras Dudosa/Floja; compite contra el pool entero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="540" width="660" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Cómo se reparten los pesos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los pesos fijos pueden sumar más de 1: se escalan proporcionalmente hasta un tope de 0,75 para todo lo que no es perfil, y el perfil se queda con el resto.&lt;br&gt;&lt;br&gt;Camino C · sin corrección: ancla 0,50 + ajuste 0,25 (si hay) · perfil 0,25-0,50.&lt;br&gt;Caminos A y B: la ancla pasa a 0,75 porque no hay q1 ni q3 y es lo único que dice cómo quiere leer; perfil 0,25 (solo q2).&lt;br&gt;Con corrección: se escalan los tres y el perfil queda en 0,25." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="820" height="240" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Piezas que sostienen el diseño&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Un vector por señal, no un texto concatenado: lo corto desaparece al concatenar.&lt;br&gt;• Las opciones fijas se vectorizan como «consultas» en idioma de catálogo: la etiqueta corta de un botón daba coseno 0,443 y traía otro tema; la consulta larga, 0,600.&lt;br&gt;• Filtro duro cuando el pedido es inequívoco (macro, forma, páginas); peso blando cuando es cuestión de grado.&lt;br&gt;• Penalización por repetición: −0,25 × similitud con lo ya mostrado; mismo autor cuenta como 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="670" width="840" height="240" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Interruptores del motor (nucleo.py)&lt;/b&gt;&lt;br&gt;ENCENDIDOS: _DOS_VECTORES (el perfil y el ajuste comparan contra experiencia) · _FILTRO_FORMA · _FILTRO_TEMA · _FILTRO_SUBGENERO · _PESO_DIVERSIDAD = 0,25.&lt;br&gt;APAGADOS: _CENTRAR (restar la media de la macro: bajaba el puntaje del juez de 3,21 a 2,96) · _ANCLA_CONTRA_SINOPSIS (la ancla y la corrección comparan hoy contra el abstracto, no contra la sinopsis)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1700" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>