{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# La privacidad "Volver" y los links viejos a /funes vuelven a la landing.
	redir /funes / 302

	@estaticos path /static/*
	header @estaticos Cache-Control "public, max-age=86400"

	try_files {path} {path}.html {path}/index.html
	file_server

	# Cualquier ruta de la app que ya no existe (QRs, /registro, /funes/<slug>)
	# lleva a la landing en vez de dar 404.
	handle_errors {
		@noexiste expression {err.status_code} == 404
		redir @noexiste / 302
	}
}
